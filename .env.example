EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Never add SUPABASE_SERVICE_ROLE_KEY to the client
# Netlify VPN proxy (optional, for regions where Supabase is blocked)
# EXPO_NETLIFY_API_KEY=https://supabase-vpn.netlify.app/api
# EXPO_PUBLIC_NETLIFY_URL=https://supabase-vpn.netlify.app/api

# AI Assistant: primary Gemini, fallback OpenRouter free or Groq (both server-side only)
# supabase secrets set GEMINI_API_KEY=... OPENROUTER_API_KEY=sk-or-v1-... GROQ_API_KEY=gsk_...
# GEMINI_API_KEY= (set via supabase secrets, not .env)
# OPENROUTER_API_KEY=sk-or-v1-... (https://openrouter.ai/keys — free 1k req/day, no region block)
# GROQ_API_KEY=gsk_... (https://console.groq.com/keys — alt fallback)

# Dev-only quick switcher (login screen + profile) — not included in production builds
# EXPO_PUBLIC_DEV_CUSTOMER_EMAIL=customer@test.com
# EXPO_PUBLIC_DEV_CUSTOMER_PASSWORD=password123
# EXPO_PUBLIC_DEV_ADMIN_EMAIL=admin@test.com
# EXPO_PUBLIC_DEV_ADMIN_PASSWORD=password123
# For admin, ensure profiles.role = 'admin' for that user in Supabase
