EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Never add SUPABASE_SERVICE_ROLE_KEY to the client

# AI Assistant: primary Gemini, fallback Groq (both server-side only)
# supabase secrets set GEMINI_API_KEY=... GROQ_API_KEY=gsk_...
# GEMINI_API_KEY= (set via supabase secrets, not .env)
# GROQ_API_KEY=gsk_... (https://console.groq.com/keys — free 14k tok/s, 100 req/day)

# Dev-only quick switcher (login screen + profile) — not included in production builds
# EXPO_PUBLIC_DEV_CUSTOMER_EMAIL=customer@test.com
# EXPO_PUBLIC_DEV_CUSTOMER_PASSWORD=password123
# EXPO_PUBLIC_DEV_ADMIN_EMAIL=admin@test.com
# EXPO_PUBLIC_DEV_ADMIN_PASSWORD=password123
# For admin, ensure profiles.role = 'admin' for that user in Supabase
